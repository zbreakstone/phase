# Copy to .env.local for local development, or add these in Vercel > Project > Settings > Environment Variables.
# Every variable is optional; the app runs with none set.

# Where saved palettes are kept. "local" stores them in the browser (localStorage).
# "supabase" saves palettes (with version history) to your account so they sync across browsers; it needs the two Supabase variables below.
NEXT_PUBLIC_STORAGE_DRIVER=local

# Public URL of the deployed site, used for absolute links in metadata and share links.
# On Vercel you can leave this empty; the app falls back to the request origin.
NEXT_PUBLIC_SITE_URL=

# Needed only for the supabase driver. The publishable key is safe in the browser; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
